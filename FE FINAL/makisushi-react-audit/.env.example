# Copy this file to .env and fill it in. .env is git-ignored.
# Postgres connection string for the Supabase project (server side only; never sent to the browser).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Budget scenarios. Only the Base budget is stored in the database
# (dw.ingredient_optimization_run.budget_php), so Low and High are set here.
BUDGET_LOW=71100
BUDGET_HIGH=91100

# Weather for the heat-index panel (Open-Meteo, no key needed). Default: Quezon City.
WEATHER_LAT=14.676
WEATHER_LON=121.0437

PORT=8787

# Sign-in, checked by the server (server/auth.js). Set the same values in the Vercel project's environment variables.
DSS_USER=admin
DSS_PASSWORD=
